/* ZipPwn 深色主题 */

QWidget {
    background: #14171c;
    color: #d6dae2;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog { background: #14171c; }

QGroupBox {
    border: 1px solid #262c36;
    border-radius: 8px;
    margin-top: 12px;
    padding: 10px 8px 8px 8px;
    font-weight: 600;
    color: #9fb0c6;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    top: 2px;
    padding: 0 4px;
}

QPushButton {
    background: #1e242d;
    border: 1px solid #2f3742;
    border-radius: 6px;
    padding: 7px 14px;
    color: #cfd7e3;
}
QPushButton:hover  { background: #262e39; border-color: #3c4756; }
QPushButton:pressed { background: #171c24; }
QPushButton:disabled { color: #56606e; background: #181c22; border-color: #23282f; }

QPushButton#primary {
    background: #2563eb;
    border: 1px solid #3b82f6;
    color: #ffffff;
    font-weight: 600;
    padding: 9px 18px;
}
QPushButton#primary:hover  { background: #2f6ff0; }
QPushButton#primary:disabled { background: #1d2b46; border-color: #24344f; color: #6b7d97; }

QLineEdit, QPlainTextEdit, QListWidget, QTableWidget, QComboBox, QSpinBox {
    background: #0f1216;
    border: 1px solid #262c36;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #3b82f6; }

QListWidget::item { padding: 4px; }
QListWidget::item:selected { background: #1d2b46; color: #cfe0ff; }

QHeaderView::section {
    background: #1a1f27;
    color: #8fa1b8;
    border: none;
    border-bottom: 1px solid #262c36;
    padding: 6px;
}

QTabWidget::pane { border: 1px solid #262c36; border-radius: 8px; top: -1px; }
QTabBar::tab {
    background: #171b21;
    color: #8b96a6;
    border: 1px solid #262c36;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 16px;
    margin-right: 2px;
}
QTabBar::tab:selected { background: #1e242d; color: #e6ecf5; }

QProgressBar {
    background: #0f1216;
    border: 1px solid #262c36;
    border-radius: 6px;
    height: 18px;
    text-align: center;
    color: #b9c4d4;
}
QProgressBar::chunk {
    background: #2563eb;
    border-radius: 5px;
}

QLabel#result {
    background: #1a1f27;
    border: 1px solid #262c36;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    color: #9fb0c6;
}

QCheckBox::indicator {
    width: 15px; height: 15px;
    border: 1px solid #3a4352;
    border-radius: 4px;
    background: #0f1216;
}
QCheckBox::indicator:checked {
    background: #2563eb;
    border-color: #3b82f6;
}

QSplitter::handle { background: #1c222b; width: 3px; }

QScrollBar:vertical { background: #14171c; width: 11px; margin: 0; }
QScrollBar::handle:vertical { background: #2f3742; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #3c4756; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

QStatusBar { background: #101317; color: #7f8b9c; }
